@model IEnumerable<RaceDayMVC.Models.ActivityViewModel>

@{
    ViewData["Title"] = "Events";
}

<h2>RaceDay Events</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Event Name</th>
            <th>Date</th>
            <th>Location</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EventId</td>
                <td>@item.EventName</td>
                <td>@item.EventDate</td>
                <td>@item.Location</td>
            </tr>
        }
    </tbody>
</table>