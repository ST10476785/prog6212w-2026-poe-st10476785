    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<RaceDayMVC.Models.CategoryViewModelcs>
@{
    ViewData["Title"] = "Categories";
    bool isAdmin = ViewBag.IsAdmin == true;
}

<h2>Categories</h2>

@if (isAdmin)
{
    <a asp-action="Create" class="btn btn-primary mb-3">Create New Category</a>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            @if (isAdmin)
            {
                <th>Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryName</td>
                <td>@item.CategoryDescription</td>
                @if (isAdmin)
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.CategoryId" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this category?');">Delete</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>